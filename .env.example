PORT=3000
APP_DOMAIN=https://api.yourdomain.com
API_KEY_HEADER=x-api-key

# Comma-separated API keys (your own keys)
FREE_API_KEYS=free-your-key-1,free-your-key-2
PAID_API_KEYS=paid-your-key-1
ADMIN_API_KEYS=paid-your-key-1

FREE_PER_HOUR_LIMIT=30
UPGRADE_URL=https://yourdomain.com/upgrade

# WhatsApp Cloud API (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Telegram Bot API (optional)
TELEGRAM_BOT_TOKEN=
